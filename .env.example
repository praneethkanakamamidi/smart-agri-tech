# Copy to .env and fill in. Never commit .env.

# --- Application ---
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log            # optional: also write logs to a file

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_DB=smart_agri_tech
POSTGRES_DB_INTERNAL_PORT=5432
POSTGRES_DB_EXTERNAL_PORT=5432
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_STATEMENT_TIMEOUT_MS=30000

# --- OTP store: mongo (default) or postgres ---
OTP_STORE=mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=smart_agri_tech
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_RETRY_WRITES=true

# --- Auth & secrets (generate long random values) ---
ACCESS_TOKEN=generate-a-long-random-secret
REFRESH_TOKEN=generate-a-different-long-random-secret
ALGORITHM=HS256
ACCESS_EXPIRY=60
REFRESH_EXPIRY=10080
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=true

# --- Email (smtp or log) ---
EMAIL_PROVIDER=smtp
EMAIL_SENDER_ADDRESS=you@example.com
EMAIL_SENDER_PASSWORD=app-password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- SMS / push / WhatsApp (log or webhook) ---
SMS_PROVIDER=log
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=
PUSH_PROVIDER=log
WHATSAPP_PROVIDER=log

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI assistant: LLM provider ---
# anthropic | openai | local | none. Comma-separate to combine (first listed is preferred, the
# rest are fallbacks). "none" keeps the agents on deterministic rules. For a hand-written
# registry use LLM_MODELS_FILE / LLM_MODELS_JSON instead (they take precedence).
LLM_PROVIDER=none
# anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
# ANTHROPIC_MODEL_STRONG=claude-opus-5-5
# ANTHROPIC_BASE_URL=                 # only behind a proxy
# openai (or any hosted OpenAI-compatible API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_STANDARD=gpt-4o
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_TRANSCRIPTION_MODEL=whisper-1   # empty = no speech-to-text
# local (Ollama, vLLM, LM Studio: an OpenAI-compatible server, no key needed)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3
# LOCAL_LLM_VISION_MODEL=              # e.g. qwen2.5vl:7b, enables photo analysis
# LOCAL_LLM_STRUCTURED_MODE=json_schema   # json_schema | json_object | prompt (what your server supports)
# LOCAL_LLM_TOOL_CALLING=false
# LOCAL_LLM_API_KEY=                   # only if the server requires one
# LLM_MODELS_FILE=config/llm_models.json

# --- AI assistant: runtime ---
# The marketplace works with the assistant off; migration 006 (PostGIS + pgvector) is still required.
AGENTS_ENABLED=true
AGENT_CHECKPOINTER=postgres          # postgres (durable) | memory (development only)
# CHECKPOINT_SCHEMA=langgraph        # created by migration 006; tables by `python -m src.agents.checkpointer setup`
# CHECKPOINT_DB_URL=                 # only if checkpoints live in another database
AGENT_WORKER_ENABLED=true            # false on the API when running `./entrypoint.sh agent-worker` separately
# AGENT_INLINE_EXECUTION=true        # run the workflow inside the request until it pauses or ends
# AGENT_INLINE_TIMEOUT_SECONDS=90
# AGENT_MAX_ATTEMPTS=3               # consecutive failures before a run is marked failed
# AGENT_MAX_STEPS=30
# AGENT_MAX_NEGOTIATION_ROUNDS=5
# AGENT_APPROVAL_TTL_HOURS=48
# AGENT_STARTS_PER_MINUTE=20         # per user
# AGENT_LLM_CALLS_PER_HOUR=400       # per user; shared across processes when REDIS_URL is set
# REDIS_URL=redis://localhost:6379/0
# LLM_LOG_CONTENT=false              # never log prompts/completions in production
# retrieval
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers (needs requirements-ml.txt) | hashing (dev/CI only)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANKER_ENABLED=false
# MATCH_DEFAULT_RADIUS_KM=100
# maps / geocoding
MAPS_PROVIDER=offline                # offline (estimates) | osrm (OSRM_BASE_URL)
# OSRM_BASE_URL=http://osrm:5000
GEOCODER_PROVIDER=none               # none | nominatim (set NOMINATIM_USER_AGENT; respect its usage policy)
# NOMINATIM_USER_AGENT=smart-agri-tech/1.0 (contact@example.com)
# retention (days)
# AGENT_EVENT_RETENTION_DAYS=90
# AGENT_MODEL_CALL_RETENTION_DAYS=90
# AGENT_TOOL_CALL_RETENTION_DAYS=365
# UNUSED_ANALYSIS_IMAGE_RETENTION_DAYS=7

# --- Operations ---
UPLOAD_DIR=uploads
SCHEDULER_ENABLED=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
METRICS_TOKEN=
# WEB_CONCURRENCY=4                # gunicorn workers

# --- pgAdmin (docker compose --profile tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
