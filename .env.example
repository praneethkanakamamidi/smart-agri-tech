# Copy to .env and fill in. Never commit .env.

# --- Application ---
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log            # optional: also write logs to a file

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_DB=smart_agri_tech
POSTGRES_DB_INTERNAL_PORT=5432
POSTGRES_DB_EXTERNAL_PORT=5432
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_STATEMENT_TIMEOUT_MS=30000

# --- OTP store: mongo (default) or postgres ---
OTP_STORE=mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=smart_agri_tech
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_RETRY_WRITES=true

# --- Auth & secrets (generate long random values) ---
ACCESS_TOKEN=generate-a-long-random-secret
REFRESH_TOKEN=generate-a-different-long-random-secret
ALGORITHM=HS256
ACCESS_EXPIRY=60
REFRESH_EXPIRY=10080
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=true

# --- Email (smtp or log) ---
EMAIL_PROVIDER=smtp
EMAIL_SENDER_ADDRESS=you@example.com
EMAIL_SENDER_PASSWORD=app-password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- SMS / push / WhatsApp (log or webhook) ---
SMS_PROVIDER=log
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=
PUSH_PROVIDER=log
WHATSAPP_PROVIDER=log

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Operations ---
UPLOAD_DIR=uploads
SCHEDULER_ENABLED=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
METRICS_TOKEN=
# WEB_CONCURRENCY=4                # gunicorn workers

# --- pgAdmin (docker compose --profile tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
